{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Card Schema",
  "type": "object",
  "required": [
    "modelName",
    "provider",
    "modelType"
  ],
  "properties": {
    "modelName": {
      "type": "string",
      "description": "Name of the model"
    },
    "provider": {
      "type": "string",
      "description": "Provider or organization that created/maintains the model"
    },
    "modelType": {
      "type": "string",
      "enum": [
        "text-generation",
        "embeddings",
        "text-to-image",
        "image-generation",
        "multimodal",
        "code-generation",
        "unknown"
      ],
      "description": "Type of model"
    },
    "version": {
      "type": "string",
      "description": "Model version"
    },
    "releaseDate": {
      "type": "string",
      "format": "date",
      "description": "Release date of the model"
    },
    "modelId": {
      "type": "string",
      "description": "Unique identifier for the model"
    },
    "description": {
      "type": "string",
      "description": "Short description of the model"
    },
    "intendedUse": {
      "type": "object",
      "properties": {
        "primaryUseCases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "parameters": {
          "type": "string"
        },
        "contextLength": {
          "type": "integer"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "trainingData": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trainingProcedure": {
      "type": "string",
      "description": "Description of training methodology"
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "evaluationData": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "performanceSummary": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ethicalConsiderations": {
      "type": "object",
      "properties": {
        "biasAndFairness": {
          "type": "string"
        },
        "safetyMeasures": {
          "type": "string"
        },
        "privacyConsiderations": {
          "type": "string"
        }
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "apiAccess": {
          "type": "string"
        },
        "rateLimits": {
          "type": "string"
        },
        "pricing": {
          "type": "string"
        },
        "licensing": {
          "type": "string"
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "hardware": {
          "type": "string"
        },
        "software": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citation": {
      "type": "string"
    },
    "additionalInfo": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    }
  }
}

